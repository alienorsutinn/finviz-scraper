# Finviz Scraper Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# SEARCH API KEYS (for debate/research layer)
# ============================================================================

# Brave Search API (Primary - recommended)
# Get your free API key at: https://brave.com/search/api/
# Free tier: 2000 queries/month
BRAVE_API_KEY=your_brave_key

# Google Custom Search Engine (Fallback)
# Get API key at: https://console.cloud.google.com/apis/credentials
# Get CSE ID at: https://programmablesearchengine.google.com/
GOOGLE_CSE_API_KEY=your_google_key
GOOGLE_CSE_CX=your_google_cx

# ============================================================================
# LLM API KEYS (for AI research synthesis)
# ============================================================================

# OpenAI API Key
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key

# OpenAI Model (optional - default: gpt-4o-mini)
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
# Note: gpt-5-mini doesn't exist yet (probably meant gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# ============================================================================
# PROXY SETTINGS (optional)
# ============================================================================

# HTTP/HTTPS Proxy (if you need to route traffic through a proxy)
# Useful if Finviz blocks your IP
# FINVIZ_PROXY=http://your-proxy:port

# ============================================================================
# DATABASE SETTINGS (for Docker deployment)
# ============================================================================

# PostgreSQL Database Configuration
# IMPORTANT: Change these in production!
POSTGRES_DB=finviz
POSTGRES_USER=finviz_user
POSTGRES_PASSWORD=change_me_in_production

# ============================================================================
# WORKFLOW SETTINGS (for GitHub Actions)
# ============================================================================

# Set to 'true' to commit scraped data back to repository
# PERSIST_RESULTS=false
